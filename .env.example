# ZIL Observatório — Environment Variables
# Copy to .env and fill in your values:  cp .env.example .env
#
# IMPORTANT: Never commit .env files with real credentials.
# This file contains ONLY placeholders and safe defaults for local development.

# ── Database ──
DATABASE_URL=postgresql://zil:zil@localhost:5432/zil
# Porta do host para o Postgres do docker compose. Se você já roda um Postgres
# local na 5432, use outra (ex: 5433) e reflita a mudança na DATABASE_URL acima.
POSTGRES_PORT=5432

# ── Cache / Queue ──
REDIS_URL=redis://localhost:6379/0

# ── Search ──
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=zil-dev-key

# ── App ──
ENV=development
# Origens autorizadas a chamar a API, separadas por vírgula. Em produção
# precisa conter o domínio do frontend (com https:// e sem barra final).
CORS_ORIGINS=https://zilmanifesto.org
# O pipeline de enriquecimento só roda onde for ligado explicitamente. Com
# false, a ANTHROPIC_API_KEY não é exigida em produção.
ENRICHMENT_ENABLED=false
CAMARA_API_BASE=https://dadosabertos.camara.leg.br/api/v2
SENADO_API_BASE=https://legis.senado.leg.br/dadosabertos

# ── Secrets (REQUIRED — fill with your own keys) ──
# Get your key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Admin token for protected endpoints (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
ADMIN_TOKEN=
